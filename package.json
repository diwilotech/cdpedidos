{
  "name": "cdpedidos",
  "version": "0.2.0",
  "private": true,
  "description": "Control de Pedidos — SPA estática servida por un Cloudflare Worker",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "db:migrate:local": "wrangler d1 execute cdpedidos-db --local --persist-to .wrangler/state --file=schema.sql",
    "test": "node scripts/test-local.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.153.0"
  }
}